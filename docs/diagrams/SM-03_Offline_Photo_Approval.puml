@startuml
' Source: MealStatus_Kitchen_Admin_OfflinePhotoUpload_Mermaid.txt
' Converted from Mermaid stateDiagram-v2 without changing states or transitions.
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam state {
  BackgroundColor #F8FAFC
  BorderColor #344054
  FontColor #1D2939
  ArrowColor #475467
}
title SM-03 - Offline Photo Capture and Approval State

  [*] --> CapturePhoto
  CapturePhoto --> SaveDraft
  SaveDraft --> QueueOffline : no internet
  QueueOffline --> UploadLater : connection returns
  SaveDraft --> UploadNow : internet available
  UploadLater --> UploadNow
  UploadNow --> Uploaded
  Uploaded --> ApprovedByAdmin : admin approves
  ApprovedByAdmin --> VisibleToParents
  VisibleToParents --> [*]
@enduml
